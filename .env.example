# PostgreSQL administrator
POSTGRES_USER=devsphere_admin
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=postgres

# Authentication database
AUTH_DB_PASSWORD=replace_me

# Catalog database
CATALOG_DB_PASSWORD=replace_me

# Orchestrator database
ORCHESTRATOR_DB_PASSWORD=replace_me

# Build database
BUILD_DB_PASSWORD=replace_me

# Deployment database
DEPLOYMENT_DB_PASSWORD=replace_me

# Configuration database
CONFIGURATION_DB_PASSWORD=replace_me

# RabbitMQ
RABBITMQ_DEFAULT_USER=devsphere_admin
RABBITMQ_DEFAULT_PASS=replace_me