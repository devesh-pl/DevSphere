# Use only after ./mvnw verify. Avoid repeated Maven downloads on an 8 GB Mac.
FROM eclipse-temurin:21-jre-alpine
RUN addgroup -S devsphere && adduser -S devsphere -G devsphere
WORKDIR /app
COPY target/project-service-spring-0.2.0-SNAPSHOT.jar /app/service.jar
USER devsphere
ENV JAVA_TOOL_OPTIONS="-Xms32m -Xmx160m -XX:MaxMetaspaceSize=144m -XX:+UseSerialGC"
EXPOSE 8087
HEALTHCHECK --interval=15s --start-period=180s --timeout=5s CMD wget -qO- http://localhost:8087/actuator/health || exit 1
ENTRYPOINT ["java","-jar","/app/service.jar"]
