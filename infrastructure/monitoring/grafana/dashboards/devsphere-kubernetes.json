{
  "uid": "devsphere-kubernetes",
  "title": "DevSphere \u2014 Kubernetes Workloads",
  "tags": [
    "devsphere",
    "kubernetes",
    "operations"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Desired Replicas",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "devsphere-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(devsphere_k8s_deployment_desired_replicas)",
          "refId": "A",
          "legendFormat": "{{deployment}}{{pod}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "orientation": "auto"
      }
    },
    {
