{
  "uid": "devsphere-build-pipeline",
  "title": "DevSphere \u2014 Build Pipeline",
  "tags": [
    "devsphere",
    "builds",
    "postgresql"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Completed Builds (24h)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "devsphere-build-db"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "devsphere-build-db"
          },
          "rawQuery": true,
          "rawSql": "\n            SELECT COUNT(*)::double precision AS value\n            FROM build_observability\n            WHERE status = 'completed'\n              AND updated_at >= NOW() - INTERVAL '24 hours'\n            ",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Failed Builds (24h)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "devsphere-build-db"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "devsphere-build-db"
          },
          "rawQuery": true,
          "rawSql": "\n            SELECT COUNT(*)::double precision AS value\n            FROM build_observability\n            WHERE status = 'failed'\n              AND updated_at >= NOW() - INTERVAL '24 hours'\n            ",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Active / Queued Builds",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "devsphere-build-db"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "devsphere-build-db"
          },
          "rawQuery": true,
          "rawSql": "\n            SELECT COUNT(*)::double precision AS value\n            FROM build_observability\n            WHERE status IN ('queued', 'building', 'deploying')\n            ",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Success Rate (24h)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "devsphere-build-db"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "devsphere-build-db"
          },
          "rawQuery": true,
          "rawSql": "\n            SELECT\n              COALESCE(\n                100.0 * COUNT(*) FILTER (WHERE status = 'completed')\n                / NULLIF(COUNT(*), 0),\n                0\n              )::double precision AS value\n            FROM build_observability\n            WHERE status IN ('completed', 'failed')\n              AND updated_at >= NOW() - INTERVAL '24 hours'\n            ",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "title": "Completed Builds Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "devsphere-build-db"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "devsphere-build-db"
          },
          "rawQuery": true,
          "rawSql": "\n            SELECT\n              date_trunc('minute', updated_at) AS time,\n              COUNT(*)::double precision AS completed\n            FROM build_observability\n            WHERE status = 'completed'\n              AND $__timeFilter(updated_at)\n            GROUP BY 1\n            ORDER BY 1\n            ",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Average End-to-End Turnaround",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "devsphere-build-db"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "devsphere-build-db"
          },
          "rawQuery": true,
          "rawSql": "\n            SELECT\n              date_trunc('minute', updated_at) AS time,\n              AVG(turnaround_seconds)::double precision AS seconds\n            FROM build_observability\n            WHERE status = 'completed'\n              AND $__timeFilter(updated_at)\n            GROUP BY 1\n            ORDER BY 1\n            ",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Builds by Attempt Count",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "devsphere-build-db"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "devsphere-build-db"
          },
          "rawQuery": true,
          "rawSql": "\n            SELECT\n              attempt_count,\n              COUNT(*)::double precision AS builds\n            FROM build_observability\n            WHERE $__timeFilter(created_at)\n            GROUP BY attempt_count\n            ORDER BY attempt_count\n            ",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Build Status Distribution",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "devsphere-build-db"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "devsphere-build-db"
          },
          "rawQuery": true,
          "rawSql": "\n            SELECT\n              status,\n              COUNT(*)::double precision AS builds\n            FROM build_observability\n            WHERE $__timeFilter(created_at)\n            GROUP BY status\n            ORDER BY status\n            ",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}