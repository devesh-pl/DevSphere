{
  "uid": "devsphere-spring",
  "title": "DevSphere Spring Boot",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Spring service availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "devsphere-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"devsphere-spring\"}",
          "refId": "A",
          "legendFormat": "{{service}} {{result}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "devsphere-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{job=\"devsphere-spring\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{service}} {{result}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP error ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "devsphere-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_count{job=\"devsphere-spring\",status=~\"5..\"}[5m])) / clamp_min(sum by (service) (rate(http_server_requests_seconds_count{job=\"devsphere-spring\"}[5m])), 0.001)",
          "refId": "A",
          "legendFormat": "{{service}} {{result}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Mean request latency (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "devsphere-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(http_server_requests_seconds_sum{job=\"devsphere-spring\"}[5m])) / clamp_min(sum by (service) (rate(http_server_requests_seconds_count{job=\"devsphere-spring\"}[5m])),0.001)",
          "refId": "A",
          "legendFormat": "{{service}} {{result}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Java reconciliation outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "devsphere-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(devsphere_reconciliation_total{job=\"devsphere-spring\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{service}} {{result}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Kubernetes ready replicas (existing collector)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "devsphere-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "devsphere_k8s_deployment_ready_replicas",
          "refId": "A",
          "legendFormat": "{{service}} {{result}}"
        }
      ]
    }
  ]
}
